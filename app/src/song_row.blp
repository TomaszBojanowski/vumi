using Gtk 4.0;

// Styled like the inside of an Adw.ActionRow (a box "header" with a box
// "title"), so the theme draws it the same way in any list. The parts that
// only some rows need are added in code: the bars of the playing song, a
// note, the ⋮ button (song_row.rs). A screen reader hears the list item's
// name (all the row shows, song_row.rs), so the labels are hidden from it:
// Orca reads a row's name and then what is inside it.
template $VumiSongRow: Box {
  valign: center;

  styles [
    "header",
    "song-row",
  ]

  Box title_box {
    orientation: vertical;
    valign: center;
    hexpand: true;

    styles [
      "title",
    ]

    Label title {
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
      accessible-role: presentation;

      styles [
        "title",
      ]
    }

    // One line: a long list of performers must not make a row taller than
    // the others.
    Label subtitle {
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
      lines: 1;
      ellipsize: end;
      accessible-role: presentation;

      styles [
        "subtitle",
      ]
    }
  }

  Label duration {
    accessible-role: presentation;

    styles [
      "dim-label",
      "numeric",
    ]
  }
}
