using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

template $MusePlayerAlbumPage: Adw.NavigationPage {
  // Lets the layout react to the page width (see the breakpoint at the end).
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    child: Adw.ToolbarView toolbar {
      [top]
      Adw.HeaderBar {}

      content: ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 1100;

          child: Box {
            orientation: vertical;
            spacing: 24;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            Box header {
              spacing: 24;

              // Same layering as the album card: note icon under the cover.
              Overlay cover_frame {
                width-request: 240;
                height-request: 240;
                valign: start;
                overflow: hidden;

                styles [
                  "card",
                  "album-cover",
                ]

                child: Image {
                  icon-name: "audio-x-generic-symbolic";
                  pixel-size: 80;

                  styles [
                    "dim-label",
                  ]
                };

                [overlay]
                Picture cover {
                  content-fit: cover;
                }
              }

              Box info {
                orientation: vertical;
                spacing: 6;
                valign: center;

                Label title {
                  xalign: 0;
                  wrap: true;

                  styles [
                    "title-1",
                    "album-title",
                  ]
                }

                // Looks like text, opens the artist page once the artist is known.
                Button artist_button {
                  halign: start;

                  styles [
                    "flat",
                    "artist-link",
                  ]

                  child: Label artist {
                    xalign: 0;
                    wrap: true;

                    styles [
                      "title-3",
                    ]
                  };
                }

                // One composer for the whole album (classical): named once here.
                Label composer {
                  xalign: 0;
                  wrap: true;
                  visible: false;
                }

                Label details {
                  xalign: 0;
                  wrap: true;

                  styles [
                    "dim-label",
                  ]
                }

                // Shown once the tracks are known, e.g. "FLAC · 24 bit / 96 kHz".
                Label quality {
                  xalign: 0;
                  halign: start;
                  visible: false;

                  styles [
                    "quality-badge",
                  ]
                }

                // Album actions: Play, Shuffle and the favourite star, added in code.
                Box actions {
                  spacing: 6;
                  margin-top: 6;
                }
              }
            }

            // "About": hidden until the server has a description.
            Box about {
              orientation: vertical;
              spacing: 6;
              visible: false;

              Label {
                label: _("About");
                xalign: 0;

                styles [
                  "heading",
                ]
              }

              Label about_text {
                xalign: 0;
                wrap: true;
                lines: 4;
                ellipsize: end;
              }

              Button about_more {
                label: _("Show more");
                halign: start;
                visible: false;

                styles [
                  "flat",
                ]
              }
            }

            Stack tracks_stack {
              // Nothing at first; the spinner appears only if loading takes a
              // while. The track list fades in from code (fade_in, album_page.rs).
              StackPage {
                name: "empty";

                child: Adw.Bin {};
              }

              StackPage {
                name: "loading";

                child: Adw.Spinner {
                  height-request: 48;
                };
              }

              StackPage {
                name: "tracks";

                // One group per disc; filled in code.
                child: Box tracks {
                  orientation: vertical;
                  spacing: 24;
                };
              }

              StackPage {
                name: "error";

                child: Adw.StatusPage error_status {
                  icon-name: "network-offline-symbolic";

                  styles [
                    "compact",
                  ]
                };
              }
            }
          };
        };
      };
    };

    // Narrow windows and phones: cover above the text, everything centred.
    Adw.Breakpoint {
      condition ("max-width: 600sp")

      setters {
        header.orientation: vertical;
        cover_frame.halign: center;
        info.halign: center;
        title.xalign: 0.5;
        title.justify: center;
        artist.xalign: 0.5;
        artist.justify: center;
        details.xalign: 0.5;
        details.justify: center;
        quality.halign: center;
        artist_button.halign: center;
        actions.halign: center;
      }
    }
  };
}
