using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// The Tuner card of the Start page: the year chosen on the scale of years
// (year_scale.rs), how many albums the library has from it, ‹ › for the year
// with albums before and after it, "Play This Year", and the row of the
// year's albums (tuner.rs).
template $VumiTuner: Adw.Bin {
  // The text and the scale stand 28 px in from the card's edges, the row of
  // album cards 6 px further out, so the covers line up with them.
  child: $VumiTintCard card {
    orientation: vertical;
    spacing: 22;

    styles [
      "card",
      "tuner",
    ]

    // On a narrow page the buttons go under the year (set_compact).
    Box header {
      spacing: 18;
      margin-start: 6;
      margin-end: 6;

      Box {
        orientation: vertical;
        hexpand: true;
        valign: end;
        spacing: 2;

        Label {
          label: _("Tuner");
          xalign: 0;

          styles [
            "caption-heading",
            "dim-label",
          ]
        }

        Label year_label {
          xalign: 0;

          styles [
            "tuner-year",
          ]
        }

        // A longer text wraps rather than widening the card.
        Label count_label {
          xalign: 0;
          wrap: true;
          margin-top: 4;

          styles [
            "dim-label",
          ]
        }
      }

      // At the foot of the header, level with the count. Under the year (a
      // narrow page) "Play This Year" goes on a line of its own under ‹ ›,
      // as wide as the card, when its whole name does not fit beside them
      // (play_row.rs).
      $VumiPlayRow buttons {
        valign: end;

        Box arrows {
          spacing: 10;

          Button prev_button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Previous Year");
            valign: center;

            styles [
              "circular",
            ]
          }

          Button next_button {
            icon-name: "go-next-symbolic";
            tooltip-text: _("Next Year");
            valign: center;

            styles [
              "circular",
            ]
          }
        }

        Button play_button {
          valign: center;

          // Shortened only when even a line of its own is too narrow
          // (set_compact).
          child: Adw.ButtonContent play_content {
            icon-name: "vumi-radio-symbolic";
            label: _("Play This Year");
          };

          styles [
            "pill",
            "tuner-play",
          ]
        }
      }
    }

    $VumiYearScale scale {
      hexpand: true;
      margin-start: 6;
      margin-end: 6;
    }

    // The albums of the year: two rows the stack crossfades between, filled
    // in tuner.rs (show_row).
    Stack rows {
      transition-type: crossfade;
      transition-duration: 250;
    }
  };
}
