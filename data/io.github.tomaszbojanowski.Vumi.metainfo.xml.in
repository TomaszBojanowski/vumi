<component type="desktop-application">
  <id>io.github.tomaszbojanowski.Vumi</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name translate="no">Vumi</name>
  <summary>Play music from your own server</summary>
  <description>
    <p>Vumi plays the music on your own Navidrome or Subsonic server. The library is kept on your computer, so it opens at once and stays quick even with thousands of albums.</p>
    <p>Pick up albums where you left them, go through the library year by year with the Tuner, and with AudioMuse-AI on the server, play similar songs and endless radio. Playback is gapless, and the music keeps playing when the window is closed.</p>
    <p>Vumi stays quick on a big library. With 651 albums and 11,333 songs from a Navidrome server in the local network, the library is on screen 0.46 s after start, a first login shows the albums in 0.56 s, and while music plays in the background Vumi uses 0.45 % of one CPU core. It is a native GTK 4 app, with no web browser inside.</p>
  </description>

  <developer id="io.github.tomaszbojanowski">
    <name translate="no">Tomasz Bojanowski</name>
  </developer>
  <launchable type="desktop-id">io.github.tomaszbojanowski.Vumi.desktop</launchable>
  <provides>
    <binary>vumi</binary>
  </provides>
  <translation type="gettext">vumi</translation>

  <url type="homepage">https://vumi.bojanowski.me/</url>
  <url type="bugtracker">https://github.com/TomaszBojanowski/vumi/issues</url>
  <url type="vcs-browser">https://github.com/TomaszBojanowski/vumi</url>
  <url type="donation">https://buymeacoffee.com/sojer2005</url>

  <content_rating type="oars-1.1"/>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#f5c25a</color>
    <color type="primary" scheme_preference="dark">#7a5317</color>
  </branding>

