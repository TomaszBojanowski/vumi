using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// Search results: the shared results view on top of the library.
template $VumiSearchPage: Adw.NavigationPage {
  title: _("Search");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: $VumiResultsView results {};
  };
}
