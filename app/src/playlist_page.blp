using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// Playlist page: a compact header (cover, name, numbers, description) with
// Play and Shuffle, and the tracks below in the shared results view.
template $VumiPlaylistPage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Box {
      orientation: vertical;

      // The same width as the results view below, so the two line up.
      Adw.Clamp {
        maximum-size: 1000;

        child: Box header {
        spacing: 18;
        margin-top: 18;
        margin-bottom: 12;
        margin-start: 24;
        margin-end: 24;

        // The list icon stays underneath; the cover goes over it once
        // loaded, made as small as it is on screen (cover_image.rs).
        Overlay {
          valign: start;
          overflow: hidden;

          styles [
            "playlist-cover",
          ]

          child: Image {
            pixel-size: 120;
            icon-name: "view-list-symbolic";
          };

          [overlay]
          $VumiCoverImage cover {}
        }

        Box {
          orientation: vertical;
          spacing: 6;
          valign: center;
          hexpand: true;

          Label name {
            xalign: 0;
            wrap: true;

            styles [
              "title-2",
            ]
          }

          Label details {
            xalign: 0;

            styles [
              "dim-label",
            ]
          }

          Label comment {
            xalign: 0;
            wrap: true;
            visible: false;

            styles [
              "dim-label",
            ]
          }

          Box actions {
            spacing: 6;
            margin-top: 6;

            // Play as a pill with its name, as on album pages.
            Button play_button {
              valign: center;

              styles [
                "pill",
                "suggested-action",
                "album-pill",
              ]

              child: Adw.ButtonContent {
                icon-name: "media-playback-start-symbolic";
                label: _("Play");
              };
            }

            Button shuffle_button {
              icon-name: "media-playlist-shuffle-symbolic";
              tooltip-text: _("Shuffle");
              valign: center;

              styles [
                "circular",
                "flat",
                "album-action",
              ]
            }
          }
        }
        };
      }

      $VumiResultsView results {
        vexpand: true;
      }

      // Why the tracks could not be shown (show_error).
      Adw.StatusPage error_status {
        icon-name: "network-offline-symbolic";
        vexpand: true;
        visible: false;

        styles [
          "compact",
        ]
      }
    };
  };
}
