using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

// The Preferences dialog (Ctrl+,). Playback for now; account and library next.
template $MusePlayerPreferences: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Account");

      Adw.ActionRow server_row {
        title: _("Server");
        subtitle-selectable: true;

        styles [
          "property",
        ]
      }

      Adw.ActionRow user_row {
        title: _("User");
        subtitle-selectable: true;

        styles [
          "property",
        ]
      }

      // Runs app.logout (main.rs) and closes the dialog.
      Adw.ButtonRow logout_row {
        title: _("Log Out");
        action-name: "app.logout";

        styles [
          "destructive-action",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Playback");

      Adw.SwitchRow endless_radio {
        title: _("Endless Radio");
        subtitle: _("When the queue ends, keep playing songs similar to the last one");
      }

      Adw.SwitchRow background_playback {
        title: _("Play After the Window Is Closed");
        subtitle: _("The music goes on; the controls stay in the system menu");
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");

      // Runs app.sync (main.rs): albums, then songs, as after connecting.
      Adw.ButtonRow sync_row {
        title: _("Sync Now");
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.sync";
      }

      Adw.ActionRow covers_row {
        title: _("Cover Cache");

        [suffix]
        Button clear_covers {
          label: _("Clear");
          valign: center;
        }
      }
    }
  }
}
