using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// Compact now-playing bar under the content on narrow windows.
// A click on it opens the sidebar with the full card.
template $VumiMiniPlayer: Adw.Bin {
  // Hidden until something plays.
  child: Revealer revealer {
    transition-type: slide_up;

    child: Box bar {
      spacing: 12;

      styles [
        "mini-player",
      ]

      Overlay {
        width-request: 40;
        height-request: 40;
        valign: center;
        overflow: hidden;

        styles [
          "now-playing-cover",
        ]

        child: Image {
          icon-name: "audio-x-generic-symbolic";
          pixel-size: 20;
          opacity: 0.6;
          accessible-role: presentation;
        };

        [overlay]
        Picture cover {
          content-fit: contain;
          accessible-role: presentation;
        }
      }

      // The way to the player for a keyboard and a screen reader: "Show
      // Player", the song as its description (mini_player.rs); a click
      // anywhere on the bar does the same.
      Box text {
        orientation: vertical;
        valign: center;
        hexpand: true;
        focusable: true;
        accessible-role: button;

        styles [
          "mini-player-text",
        ]

        Label title {
          xalign: 0;
          ellipsize: end;
          max-width-chars: 1;
          accessible-role: presentation;

          styles [
            "heading",
          ]
        }

        Label artist {
          xalign: 0;
          ellipsize: end;
          max-width-chars: 1;
          opacity: 0.75;
          accessible-role: presentation;

          styles [
            "caption",
          ]
        }
      }

      Button play_pause {
        icon-name: "media-playback-pause-symbolic";
        valign: center;

        styles [
          "flat",
          "circular",
        ]
      }
    };
  };
}
