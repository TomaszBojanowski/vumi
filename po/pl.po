#: data/io.github.tomaszbojanowski.MusePlayer.desktop.in:2
msgid "muse-player"
msgstr "muse-player"

#: data/io.github.tomaszbojanowski.MusePlayer.desktop.in:3
msgid "Fast music player for Navidrome and Subsonic servers"
msgstr "Szybki odtwarzacz muzyki z serwerów Navidrome i Subsonic"

#: data/io.github.tomaszbojanowski.MusePlayer.desktop.in:9
msgid "music;player;navidrome;subsonic;"
msgstr "muzyka;odtwarzacz;navidrome;subsonic;music;player;"

#: app/src/main.rs:192 app/src/login_page.rs:153 app/src/album_page.rs:139
msgid "Something went wrong. Please try again."
msgstr "Wystąpił nieoczekiwany błąd. Spróbuj ponownie."

#: app/src/main.rs:201
msgid "Wrong username or password."
msgstr "Nieprawidłowa nazwa użytkownika lub hasło."

#: app/src/main.rs:202
msgid "Cannot reach the server. Check the address and your connection."
msgstr ""
"Nie uzyskano połączenia z serwerem. Sprawdź adres i połączenie sieciowe."

#: app/src/main.rs:203
msgid "Invalid server address. It should start with http:// or https://"
msgstr ""
"Nieprawidłowy adres serwera. Adres musi zaczynać się od http:// lub https://"

#: app/src/main.rs:204
msgid "The server answered, but it does not look like a Subsonic server."
msgstr "Serwer odpowiedział, ale nie wygląda na serwer zgodny z Subsonic."

#. Translators: {message} is the error text sent by the server.
#: app/src/main.rs:206
#, rust-format
msgid "Server error: {message}"
msgstr "Błąd serwera: {message}"

#: app/src/main_view.rs:181
msgid "Connecting…"
msgstr "Łączenie…"

#. Translators: {server} is the server software (e.g. navidrome), {version} its version.
#: app/src/main_view.rs:189
#, rust-format
msgid "Connected to {server} {version}"
msgstr "Połączono z serwerem {server} {version}"

#: app/src/main_view.rs:200
msgid "Offline"
msgstr "Brak połączenia"

#: app/src/main_view.blp:21
msgid "Hide sidebar"
msgstr "Ukryj panel boczny"

#: app/src/main_view.blp:54 app/src/main_view.blp:62 app/src/main_view.blp:95
#: app/src/artist_page.blp:86
msgid "Albums"
msgstr "Albumy"

#: app/src/main_view.blp:57
msgid "Library"
msgstr "Biblioteka"

#: app/src/main_view.blp:70 app/src/main_view.blp:134 app/src/main_view.blp:163
#: app/src/main_view.blp:188 app/src/main_view.blp:217
msgid "Show sidebar"
msgstr "Wyświetl panel boczny"

#: app/src/main_view.blp:78
msgid "Sort"
msgstr "Sortowanie"

#: app/src/main_view.blp:86
msgid "Retry"
msgstr "Spróbuj ponownie"

#: app/src/main_view.blp:125 app/src/main_view.blp:142
msgid "Artists"
msgstr "Wykonawcy"

#: app/src/main_view.blp:143 app/src/main_view.blp:172
#: app/src/main_view.blp:197 app/src/main_view.blp:226
msgid "Coming soon"
msgstr "Wkrótce"

#: app/src/main_view.blp:152 app/src/main_view.blp:171
msgid "Favorites"
msgstr "Ulubione"

#: app/src/main_view.blp:155
msgid "Collections"
msgstr "Kolekcje"

#: app/src/main_view.blp:179 app/src/main_view.blp:196
msgid "Playlists"
msgstr "Listy odtwarzania"

#: app/src/main_view.blp:206 app/src/main_view.blp:225
msgid "Similar and Radio"
msgstr "Podobne i radio"

#: app/src/main_view.blp:209
msgid "Discover"
msgstr "Odkrywanie"

#: app/src/main_view.blp:257
msgid "Name"
msgstr "Nazwa"

#: app/src/main_view.blp:263
msgid "Artist"
msgstr "Wykonawca"

#: app/src/main_view.blp:269
msgid "Year (Newest)"
msgstr "Rok (od najnowszych)"

#: app/src/main_view.blp:275
msgid "Year (Oldest)"
msgstr "Rok (od najstarszych)"

#: app/src/main_view.blp:281
msgid "Recently Added"
msgstr "Ostatnio dodane"

#: app/src/login_page.rs:130 app/src/login_page.blp:7 app/src/login_page.blp:55
msgid "Connect"
msgstr "Połącz"

#: app/src/login_page.blp:15
msgid "Connect to Your Server"
msgstr "Połączenie z serwerem"

#: app/src/login_page.blp:16
msgid "Navidrome or another Subsonic-compatible server"
msgstr "Serwer Navidrome lub inny zgodny z Subsonic"

#: app/src/login_page.blp:31
msgid "Server address"
msgstr "Adres serwera"

#: app/src/login_page.blp:35
msgid "Username"
msgstr "Nazwa użytkownika"

#: app/src/login_page.blp:39
msgid "Password"
msgstr "Hasło"

#. Translators: {app_name} is the name of this application.
#: app/src/welcome_page.rs:63
#, rust-format
msgid "Welcome to {app_name}"
msgstr "Witamy w aplikacji {app_name}"

#: app/src/welcome_page.rs:70
msgid "Get Started"
msgstr "Rozpocznij"

#: app/src/welcome_page.rs:70 app/src/welcome_page.blp:61
#: app/src/now_playing.blp:161
msgid "Next"
msgstr "Następny"

#: app/src/welcome_page.blp:21
msgid "A fast music player for your own music server."
msgstr "Szybki odtwarzacz muzyki z własnego serwera."

#: app/src/welcome_page.blp:28
msgid "Your Library, Instantly"
msgstr "Biblioteka w mgnieniu oka"

#: app/src/welcome_page.blp:29
msgid ""
"Browse thousands of albums without waiting. Everything stays smooth, even "
"with huge collections."
msgstr ""
"Tysiące albumów bez czekania. Wszystko działa płynnie nawet przy bardzo "
"dużych kolekcjach."

#: app/src/welcome_page.blp:36
msgid "Discover Music"
msgstr "Odkrywanie muzyki"

#: app/src/welcome_page.blp:37
msgid ""
"Similar songs, endless radio and search by mood, powered by AudioMuse-AI."
msgstr ""
"Podobne utwory, niekończące się radio i wyszukiwanie według nastroju dzięki "
"programowi AudioMuse-AI."

#: app/src/welcome_page.blp:44
msgid "Hear Every Detail"
msgstr "Każdy szczegół brzmienia"

#: app/src/welcome_page.blp:45
msgid "Original quality streaming, gapless playback and bit-perfect output."
msgstr ""
"Strumieniowanie w oryginalnej jakości, odtwarzanie bez przerw i wyjście bit-"
"perfect."

#: app/src/album_page.rs:106
msgid "Connect to the server to see the tracks."
msgstr "Lista utworów będzie dostępna po połączeniu z serwerem."

#: app/src/album_page.rs:161 app/src/album_page.rs:530
#: app/src/now_playing.rs:180 app/src/mini_player.rs:101
msgid "Play"
msgstr "Odtwórz"

#: app/src/album_page.rs:168
msgid "Shuffle"
msgstr "Losowo"

#. Translators: header above the tracks of one disc, e.g. "Disc 2".
#: app/src/album_page.rs:240
#, rust-format
msgid "Disc {n}"
msgstr "Płyta {n}"

#. Translators: {n} is a number of discs.
#: app/src/album_page.rs:278
#, rust-format
msgid "{n} disc"
msgid_plural "{n} discs"
msgstr[0] "{n} płyta"
msgstr[1] "{n} płyty"
msgstr[2] "{n} płyt"

#. Translators: {n} is a number of tracks.
#: app/src/album_page.rs:281
#, rust-format
msgid "{n} track"
msgid_plural "{n} tracks"
msgstr[0] "{n} utwór"
msgstr[1] "{n} utwory"
msgstr[2] "{n} utworów"

#. Translators: {n} is a number of minutes.
#: app/src/album_page.rs:400
#, rust-format
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuta"
msgstr[1] "{n} minuty"
msgstr[2] "{n} minut"

#. Translators: total length of a long album, e.g. "6 h 9 min".
#: app/src/album_page.rs:403
#, rust-format
msgid "{hours} h {minutes} min"
msgstr "{hours} godz. {minutes} min"

#. Translators: tracks of one album differ in quality, e.g. "FLAC · up to 24 bit / 96 kHz".
#: app/src/album_page.rs:436
#, rust-format
msgid "{format} · up to {quality}"
msgstr "{format} · do {quality}"

#. Translators: audio bit depth, e.g. "24 bit".
#: app/src/album_page.rs:447
#, rust-format
msgid "{n} bit"
msgstr "{n} bit"

#. Translators: sample rate, e.g. "96 kHz".
#: app/src/album_page.rs:455
#, rust-format
msgid "{khz} kHz"
msgstr "{khz} kHz"

#. Translators: sample rate with one decimal, e.g. "44.1 kHz"; use your decimal separator.
#: app/src/album_page.rs:458
#, rust-format
msgid "{whole}.{fraction} kHz"
msgstr "{whole},{fraction} kHz"

#: app/src/album_page.rs:526 app/src/now_playing.rs:176
#: app/src/mini_player.rs:98
msgid "Pause"
msgstr "Wstrzymaj"

#: app/src/album_page.rs:528
msgid "Resume"
msgstr "Wznów"

#: app/src/album_page.blp:128 app/src/artist_page.blp:59
msgid "About"
msgstr "Informacje"

#: app/src/album_page.blp:144 app/src/about.rs:64 app/src/artist_page.blp:75
msgid "Show more"
msgstr "Wyświetl więcej"

#: app/src/favorites.rs:73
msgid "Could not change favorites. Please try again."
msgstr "Nie udało się zmienić ulubionych. Spróbuj ponownie."

#: app/src/favorites.rs:83
msgid "Remove from favorites"
msgstr "Usuń z ulubionych"

#: app/src/favorites.rs:86
msgid "Add to favorites"
msgstr "Dodaj do ulubionych"

#: app/src/about.rs:68
msgid "Show less"
msgstr "Wyświetl mniej"

#: app/src/artist_page.rs:119
#, rust-format
msgid "{n} album"
msgid_plural "{n} albums"
msgstr[0] "{n} album"
msgstr[1] "{n} albumy"
msgstr[2] "{n} albumów"

#: app/src/now_playing.rs:128
msgid "Go to album"
msgstr "Przejdź do albumu"

#: app/src/now_playing.blp:140
msgid "Previous"
msgstr "Poprzedni"
