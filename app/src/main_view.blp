using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

template $MusePlayerMainView: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    // Hidden until the server cannot be reached.
    [top]
    Adw.Banner banner {
      button-label: _("Retry");
    }

    content: Stack stack {
      StackPage {
        name: "status";

        child: Adw.StatusPage status {
          icon-name: "audio-x-generic-symbolic";
          title: _("Library");
        };
      }

      StackPage {
        name: "library";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          // Only visible cards exist; they are reused while scrolling.
          child: GridView grid {
            min-columns: 2;
            max-columns: 12;
            single-click-activate: true;
          };
        };
      }
    };
  };
}
