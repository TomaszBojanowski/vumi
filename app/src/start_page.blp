using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

// The Start page: shelves that answer "what shall I listen to now".
template $MusePlayerStartPage: Adw.Bin {
  // Lets the page react to its own width (see the breakpoint at the end).
  child: Adw.BreakpointBin {
    width-request: 300;
    height-request: 200;

    child: ScrolledWindow {
      hscrollbar-policy: never;

      child: Box {
        orientation: vertical;
        spacing: 24;
        margin-top: 24;
        // More room at the end, so the last shelf does not touch the edge.
        margin-bottom: 48;
        margin-start: 24;
        margin-end: 24;

        // The two cards at the top: "Last Played" and a random album, side by
        // side, or one under the other (the breakpoints below).
        Box top_row {
          spacing: 18;

          // "Continue listening": the album that played last, resumed where it
          // stopped. Hidden until something has played. 560 px wide, or the
          // whole width on narrow windows (the breakpoint below).
          Box continue_card {
            spacing: 18;
            hexpand: true;
            visible: false;

            styles [
              "card",
              "continue-card",
            ]

            Overlay continue_cover_frame {
              width-request: 160;
              height-request: 160;
              valign: center;
              overflow: hidden;

              styles [
                "continue-cover",
              ]

              child: Image {
                icon-name: "audio-x-generic-symbolic";
                pixel-size: 64;

                styles [
                  "dim-label",
                ]
              };

              [overlay]
              Picture continue_cover {
                content-fit: cover;
              }
            }

            Box {
              orientation: vertical;
              valign: center;
              spacing: 4;
              hexpand: true;

              Label {
                label: _("Last Played");
                xalign: 0;

                styles [
                  "caption",
                  "dim-label",
                ]
              }

              Label continue_title {
                xalign: 0;
                ellipsize: end;

                styles [
                  "title-1",
                ]
              }

              Label continue_subtitle {
                xalign: 0;
                ellipsize: end;

                styles [
                  "dim-label",
                ]
              }

              Button continue_button {
                halign: start;
                margin-top: 8;

                styles [
                  "pill",
                  "suggested-action",
                ]

                child: Adw.ButtonContent {
                  icon-name: "media-playback-start-symbolic";
                  label: _("Continue");
                };
              }
            }
          }

          // "Random Album": something from the library to listen to next.
          Box random_card {
            spacing: 18;
            halign: start;
            width-request: 380;
            visible: false;

            styles [
              "card",
              "continue-card",
            ]

            Overlay random_cover_frame {
              width-request: 100;
              height-request: 100;
              valign: center;
              overflow: hidden;

              styles [
                "continue-cover",
              ]

              child: Image {
                icon-name: "media-optical-symbolic";
                pixel-size: 40;

                styles [
                  "dim-label",
                ]
              };

              [overlay]
              Picture random_cover {
                content-fit: cover;
              }
            }

            Box {
              orientation: vertical;
              valign: center;
              spacing: 4;
              hexpand: true;

              Label {
                label: _("Random Album");
                xalign: 0;

                styles [
                  "caption",
                  "dim-label",
                ]
              }

              Label random_title {
                xalign: 0;
                ellipsize: end;
                // Long names shorten, so the card never grows past its width.
                max-width-chars: 24;

                styles [
                  "title-3",
                ]
              }

              Label random_subtitle {
                xalign: 0;
                ellipsize: end;
                // Long names shorten, so the card never grows past its width.
                max-width-chars: 24;

                styles [
                  "dim-label",
                ]
              }

              Box {
                spacing: 8;
                margin-top: 8;

                Button random_play {
                  styles [
                    "pill",
                  ]

                  child: Adw.ButtonContent {
                    icon-name: "media-playback-start-symbolic";
                    label: _("Play");
                  };
                }

                Button random_next {
                  icon-name: "media-playlist-shuffle-symbolic";
                  tooltip-text: _("Another Random Album");
                  valign: center;

                  styles [
                    "circular",
                  ]
                }
              }
            }
          }
        }

        // Hidden until there is something to show.
        Box recent_shelf {
          orientation: vertical;
          spacing: 12;
          visible: false;

          Box {
            spacing: 8;

            Label {
              label: _("Recently Added");
              xalign: 0;

              styles [
                "title-4",
              ]
            }

            // ‹ ›: move the row by what is visible (see connect_arrows).
            Box {
              hexpand: true;
              halign: end;
              spacing: 6;

              Button recent_prev {
                icon-name: "go-previous-symbolic";
                tooltip-text: _("Previous Albums");
                valign: center;

                styles [
                  "circular",
                  "flat",
                ]
              }

              Button recent_next {
                icon-name: "go-next-symbolic";
                tooltip-text: _("Next Albums");
                valign: center;

                styles [
                  "circular",
                  "flat",
                ]
              }
            }
          }

          // One row of albums; it scrolls sideways when the window is narrow.
          ScrolledWindow recent_scroll {
            vscrollbar-policy: never;
            // The ‹ › buttons move the row; no scrollbar over the album names.
            hscrollbar-policy: external;

            child: Box recent_row {
              spacing: 12;
            };
          }
        }

        // "Similar to …": albums with songs that sound like the one that played
        // last (AudioMuse-AI through Navidrome). Hidden until there is something.
        Box similar_shelf {
          orientation: vertical;
          spacing: 12;
          visible: false;

          Box {
            spacing: 8;

            Label similar_title {
              xalign: 0;
              ellipsize: end;

              styles [
                "title-4",
              ]
            }

            Button similar_radio {
              icon-name: "muse-player-radio-symbolic";
              tooltip-text: _("Play Similar Songs");
              valign: center;

              styles [
                "circular",
                "flat",
              ]
            }

            // ‹ ›: move the row by what is visible (see connect_arrows).
            Box {
              hexpand: true;
              halign: end;
              spacing: 6;

              Button similar_prev {
                icon-name: "go-previous-symbolic";
                tooltip-text: _("Previous Albums");
                valign: center;

                styles [
                  "circular",
                  "flat",
                ]
              }

              Button similar_next {
                icon-name: "go-next-symbolic";
                tooltip-text: _("Next Albums");
                valign: center;

                styles [
                  "circular",
                  "flat",
                ]
              }
            }
          }

          ScrolledWindow similar_scroll {
            vscrollbar-policy: never;
            // The ‹ › buttons move the row; no scrollbar over the album names.
            hscrollbar-policy: external;

            child: Box similar_row {
              spacing: 12;
            };
          }
        }
      };
    };

    // Medium: the hero and the random album card do not fit side by side, so
    // they go one under the other. The conditions do not overlap, so only one
    // breakpoint applies at a time.
    Adw.Breakpoint {
      condition ("max-width: 900sp and min-width: 621sp")

      setters {
        top_row.orientation: vertical;
      }
    }

    // Narrow: the random album card takes the width there is instead of its
    // usual 380 px, and the covers shrink.
    Adw.Breakpoint {
      condition ("max-width: 620sp")

      setters {
        top_row.orientation: vertical;
        continue_cover_frame.width-request: 80;
        continue_cover_frame.height-request: 80;
        random_card.width-request: -1;
        random_card.halign: fill;
        random_cover_frame.width-request: 80;
        random_cover_frame.height-request: 80;
      }
    }
  };
}
