using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

// Full "now playing" view: a floating window on wide screens,
// a sheet sliding up from the bottom on narrow ones.
template $MusePlayerNowPlayingView: Adw.Dialog {
  title: _("Now Playing");
  content-width: 440;
  content-height: 720;

  child: Adw.ToolbarView toolbar {
    [top]
    Adw.HeaderBar {
      show-title: false;
    }

    content: Adw.Clamp {
      maximum-size: 400;

      child: Box {
        orientation: vertical;
        spacing: 16;
        valign: center;
        margin-top: 8;
        margin-bottom: 32;
        margin-start: 24;
        margin-end: 24;

        AspectFrame {
          ratio: 1;
          obey-child: false;

          child: Overlay {
            overflow: hidden;

            styles [
              "card",
              "album-cover",
            ]

            child: Image {
              icon-name: "audio-x-generic-symbolic";
              pixel-size: 96;

              styles [
                "dim-label",
              ]
            };

            [overlay]
            Picture cover {
              content-fit: cover;
            }
          };
        }

        Box {
          orientation: vertical;
          spacing: 4;

          Label title {
            wrap: true;
            justify: center;

            styles [
              "title-2",
            ]
          }

          Label artist {
            wrap: true;
            justify: center;

            styles [
              "title-4",
            ]
          }

          Label album {
            wrap: true;
            justify: center;

            styles [
              "dim-label",
            ]
          }
        }

        Label quality {
          halign: center;
          visible: false;

          styles [
            "quality-badge",
          ]
        }

        Box {
          orientation: vertical;

          Scale progress {
            adjustment: Adjustment {
              lower: 0;
              upper: 1;
            };
          }

          Box {
            margin-start: 10;
            margin-end: 10;

            Label elapsed {
              hexpand: true;
              xalign: 0;

              styles [
                "caption",
                "numeric",
                "dim-label",
              ]
            }

            Label total {
              styles [
                "caption",
                "numeric",
                "dim-label",
              ]
            }
          }
        }

        Box {
          halign: center;
          spacing: 24;

          Button previous {
            icon-name: "media-skip-backward-symbolic";
            tooltip-text: _("Previous");
            valign: center;

            styles [
              "flat",
              "circular",
            ]
          }

          Button play_pause {
            icon-name: "media-playback-pause-symbolic";
            valign: center;

            styles [
              "circular",
              "suggested-action",
              "big-play",
            ]
          }

          Button next {
            icon-name: "media-skip-forward-symbolic";
            tooltip-text: _("Next");
            valign: center;

            styles [
              "flat",
              "circular",
            ]
          }
        }
      };
    };
  };
}
