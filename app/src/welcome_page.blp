using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

template $VumiWelcomePage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Box {
      orientation: vertical;

      Adw.Carousel carousel {
        hexpand: true;
        vexpand: true;

        // The title is set in code: it contains the app name.
        Adw.StatusPage welcome_status {
          icon-name: "audio-x-generic-symbolic";
          description: _("A fast music player for your own music server.");
          hexpand: true;
          vexpand: true;
        }

        Adw.StatusPage {
          icon-name: "view-grid-symbolic";
          title: _("Your Library, Instantly");
          description: _("Browse thousands of albums without waiting. Everything stays smooth, even with huge collections.");
          hexpand: true;
          vexpand: true;
        }

        Adw.StatusPage {
          icon-name: "system-search-symbolic";
          title: _("Discover Music");
          description: _("Similar songs and endless radio straight from your server.");
          hexpand: true;
          vexpand: true;
        }

        Adw.StatusPage {
          icon-name: "audio-speakers-symbolic";
          title: _("Hear Every Detail");
          description: _("Original quality streaming and gapless playback.");
          hexpand: true;
          vexpand: true;
        }
      }

      Box {
        orientation: vertical;
        spacing: 18;
        margin-bottom: 24;

        Adw.CarouselIndicatorDots {
          carousel: carousel;
        }

        Button next_button {
          // Not the player's "Next" (the next track).
          label: C_("welcome", "Next");
          halign: center;

          styles [
            "suggested-action",
            "pill",
          ]
        }
      }
    };
  };
}
