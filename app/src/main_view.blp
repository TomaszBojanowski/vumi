using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

template $VumiMainView: Adw.NavigationPage {
  // Lets the layout react to the window width (see the breakpoint at the end).
  child: Adw.BreakpointBin {
    width-request: 366;
    height-request: 294;

    child: Adw.OverlaySplitView split {
      // A fixed width, wide enough for the now-playing card, so the
      // sidebar does not grow (and shift the content) when the card appears.
      min-sidebar-width: 300;
      max-sidebar-width: 300;
      // Navigation on the left; its items and sections come from the pages of "views".
      sidebar: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          // Closes the sidebar when it slides in over the content (narrow windows).
          [start]
          ToggleButton {
            icon-name: "sidebar-show-symbolic";
            tooltip-text: _("Hide Sidebar");
            visible: bind split.collapsed;
            active: bind split.show-sidebar bidirectional;
          }

          title-widget: Adw.WindowTitle {
            title: "Vumi";
          };

          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            primary: true;
            tooltip-text: _("Main Menu");
            menu-model: main_menu;
          }

          // Runs app.sync; a spinner while a sync runs (set_syncing, main_view.rs).
          [end]
          Button sync_button {
            icon-name: "view-refresh-symbolic";
            tooltip-text: _("Sync Library");
            action-name: "app.sync";
          }
        }

        content: Box {
          orientation: vertical;

          SearchEntry search_entry {
            // Also the name of the shortcut (main.rs), which reads differently.
            placeholder-text: C_("placeholder", "Search Library");
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 12;
            margin-end: 12;
          }

          Adw.ViewSwitcherSidebar sections {
            stack: views;
            vexpand: true;
          }

          // The now-playing card, placed here from code.
          Adw.Bin player_slot {}
        };
      };

      // The queue on the right: side by side on wide windows, over the content
      // on narrow ones (the breakpoint below). Hidden until asked for.
      content: Adw.OverlaySplitView queue_split {
        sidebar-position: end;
        show-sidebar: false;
        // Stays as it was left: widening the window does not open it (see
        // setup_queue for narrow windows).
        pin-sidebar: true;
        min-sidebar-width: 280;
        max-sidebar-width: 380;

        sidebar: $VumiQueuePage queue_page {};

        content: Box {
        orientation: vertical;

        Adw.ViewStack views {
          vexpand: true;

          // First item, so it opens by default.
          Adw.ViewStackPage {
            name: "start";
            title: _("Start");
            icon-name: "go-home-symbolic";

            // Its own navigation: an album opened from here comes back here.
            child: Adw.NavigationView {
              Adw.NavigationPage {
                title: _("Start");

                child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: _("Start");
                };

                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show Sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              content: $VumiStartPage start_page {};
            };
              }
            };
          }

          // Section "Library" ---------------------------------------------

          Adw.ViewStackPage albums_page {
            name: "library";
            title: _("Albums");
            icon-name: "media-optical-symbolic";
            starts-section: true;
            section-title: _("Library");

            // Albums and artists open here, next to the sidebar.
            child: Adw.NavigationView library_nav {
              Adw.NavigationPage {
                title: _("Albums");

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    [start]
                    ToggleButton {
                      icon-name: "sidebar-show-symbolic";
                      tooltip-text: _("Show Sidebar");
                      visible: bind split.collapsed;
                      active: bind split.show-sidebar bidirectional;
                    }

                    [end]
                    MenuButton {
                      icon-name: "view-sort-descending-symbolic";
                      tooltip-text: _("Sort");
                      menu-model: sort_menu;
                    }
                  }

                  // Hidden until the server cannot be reached.
                  [top]
                  Adw.Banner banner {
                    button-label: _("Retry");
                  }

                  content: Stack stack {
                    StackPage {
                      name: "status";

                      child: Adw.StatusPage status {
                        icon-name: "media-optical-symbolic";
                        title: _("Albums");
                      };
                    }

                    StackPage {
                      name: "library";

                      child: ScrolledWindow {
                        hscrollbar-policy: never;

                        // Only visible cards exist; they are reused while scrolling.
                        child: GridView grid {
                          min-columns: 2;
                          max-columns: 12;
                          single-click-activate: true;

                          styles [
                            "library-grid",
                          ]
                        };
                      };
                    }
                  };
                };
              }
            };
          }

          Adw.ViewStackPage artists_page {
            name: "artists";
            title: _("Artists");
            icon-name: "system-users-symbolic";

            // Artist pages open here, on top of the list.
            child: Adw.NavigationView {
              Adw.NavigationPage {
                title: _("Artists");

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    [start]
                    ToggleButton {
                      icon-name: "sidebar-show-symbolic";
                      tooltip-text: _("Show Sidebar");
                      visible: bind split.collapsed;
                      active: bind split.show-sidebar bidirectional;
                    }
                  }

                  content: Stack artists_stack {
                    StackPage {
                      name: "empty";

                      child: Adw.StatusPage {
                        icon-name: "system-users-symbolic";
                        title: _("Artists");
                      };
                    }

                    StackPage {
                      name: "list";

                      child: Box {
                        orientation: vertical;

                        styles [
                          "artists-list",
                        ]

                        // A button per first letter; it scrolls the grid there.
                        Adw.Clamp {
                          maximum-size: 1200;

                          child: Adw.WrapBox artists_letters {
                            child-spacing: 2;
                            line-spacing: 2;
                            margin-top: 6;
                            margin-start: 24;
                            margin-end: 24;
                            accessible-role: group;

                            accessibility {
                              label: _("Jump to Letter");
                            }
                          };
                        }

                        ScrolledWindow {
                          hscrollbar-policy: never;
                          vexpand: true;

                          // Scrollable itself, so the grid inside still knows
                          // what is on screen.
                          child: Adw.ClampScrollable {
                            maximum-size: 1200;

                            // Only visible cards exist; they are reused while scrolling.
                            child: GridView artists_grid {
                              min-columns: 2;
                              max-columns: 12;
                              single-click-activate: true;

                              styles [
                                "artists-grid",
                              ]
                            };
                          };
                        }
                      };
                    }
                  };
                };
              }
            };
          }

          // Section "Collections" -----------------------------------------

          Adw.ViewStackPage {
            name: "favorites";
            title: _("Favorites");
            icon-name: "starred-symbolic";
            starts-section: true;
            section-title: _("Collections");

            // Its own navigation: an album opened from here comes back here.
            child: Adw.NavigationView {
              Adw.NavigationPage {
                title: _("Favorites");

                // Takes the colour of the first cover in the header, as an
                // album page takes its cover's (main_view.rs).
                child: Adw.ToolbarView favorites_toolbar {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show Sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              // Starred albums and songs, from the local database
              // (main_view.rs). The bin tells the page when it is narrow:
              // its header gets smaller then.
              content: Adw.BreakpointBin {
                width-request: 300;
                height-request: 200;

                child: $VumiResultsView favorites {};

                Adw.Breakpoint favorites_narrow {
                  condition ("max-width: 520sp")
                }
              };
            };
              }
            };
          }

          Adw.ViewStackPage playlists_page {
            name: "playlists";
            title: _("Playlists");
            icon-name: "view-list-symbolic";

            // Playlist pages open here, on top of the list.
            child: Adw.NavigationView {
              Adw.NavigationPage {
                title: _("Playlists");

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    [start]
                    ToggleButton {
                      icon-name: "sidebar-show-symbolic";
                      tooltip-text: _("Show Sidebar");
                      visible: bind split.collapsed;
                      active: bind split.show-sidebar bidirectional;
                    }
                  }

                  content: Stack playlists_stack {
                    StackPage {
                      name: "empty";

                      child: Adw.StatusPage {
                        icon-name: "view-list-symbolic";
                        title: _("No Playlists");
                        description: _("Playlists from the server appear here");
                      };
                    }

                    StackPage {
                      name: "list";

                      // The section asks only for the width of one column
                      // of cards, whatever it shows: two columns as its own
                      // minimum would leave no room for the queue beside it.
                      child: Adw.BreakpointBin {
                        width-request: 366;
                        height-request: 150;

                        child: ScrolledWindow {
                          hscrollbar-policy: never;

                          child: Adw.Clamp {
                            maximum-size: 1200;

                            // Wide cards in one column, or in two where the
                            // section is wide enough (the breakpoint below),
                            // laid out in code.
                            child: Grid playlists_grid {
                              column-homogeneous: true;
                              column-spacing: 12;
                              row-spacing: 12;
                              margin-top: 24;
                              margin-bottom: 24;
                              margin-start: 24;
                              margin-end: 24;
                              valign: start;
                            };
                          };
                        };

                        // Room for two columns of cards; the code listens to it.
                        Adw.Breakpoint playlists_wide {
                          condition ("min-width: 700sp")
                        }
                      };
                    }
                  };
                };
              }
            };
          }

          // Section "Discover" (AudioMuse-AI) -----------------------------

          // Hidden, and so left out of the sidebar, until the view exists.
          Adw.ViewStackPage {
            visible: false;
            name: "discover";
            title: _("Similar and Radio");
            icon-name: "applications-multimedia-symbolic";
            starts-section: true;
            section-title: _("Discover");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show Sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              content: Adw.StatusPage {
                icon-name: "applications-multimedia-symbolic";
                title: _("Similar and Radio");
                description: _("Coming soon");
              };
            };
          }
        }

        // Narrow windows: a compact now-playing bar, placed here from code.
        Revealer {
          reveal-child: bind split.collapsed;
          transition-type: slide_up;

          child: Adw.Bin mini_slot {};
        }
      };
      };
    };

    // Medium windows: the queue no longer fits beside the content and the
    // sidebar, so it slides in over the content. (With several breakpoints the
    // last one that matches wins: the narrow one below comes after this.)
    Adw.Breakpoint {
      condition ("max-width: 1000sp")

      setters {
        queue_split.collapsed: true;
      }
    }

    // Narrow windows: the sidebar hides and slides in over the content.
    Adw.Breakpoint {
      condition ("max-width: 700sp")

      setters {
        split.collapsed: true;
        queue_split.collapsed: true;
      }
    }
  };
}

// Sort order of the album grid; a radio group driven by the "library.sort" action.
menu sort_menu {
  section {
    item {
      label: _("Name");
      action: "library.sort";
      target: "name";
    }

    item {
      label: _("Artist");
      action: "library.sort";
      target: "artist";
    }

    item {
      label: _("Year (Newest)");
      action: "library.sort";
      target: "year-desc";
    }

    item {
      label: _("Year (Oldest)");
      action: "library.sort";
      target: "year-asc";
    }

    item {
      label: _("Recently Added");
      action: "library.sort";
      target: "added";
    }
  }
}

// The main menu (the ☰ button above the sidebar).
menu main_menu {
  section {
    item {
      label: _("Endless Radio");
      action: "app.endless-radio";
    }

    submenu {
      label: _("Repeat");

      item {
        label: _("Off");
        action: "app.repeat";
        target: "none";
      }

      item {
        label: _("Queue");
        action: "app.repeat";
        target: "queue";
      }

      item {
        label: _("Track");
        action: "app.repeat";
        target: "track";
      }
    }
  }

  section {
    item {
      label: _("Sync Library");
      action: "app.sync";
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("About Vumi");
      action: "app.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
