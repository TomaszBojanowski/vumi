using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// The Preferences dialog (Ctrl+,). Playback for now; account and library next.
template $VumiPreferences: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Account");

      // The address, and under it whether the server answers (preferences.rs):
      // a "property" row built by hand, for the line with the mark below.
      Adw.PreferencesRow {
        title: _("Server");
        activatable: false;

        child: Box {
          orientation: vertical;
          spacing: 3;
          valign: center;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 12;
          margin-end: 12;

          Label {
            label: _("Server");
            xalign: 0;

            styles [
              "subtitle",
            ]
          }

          Label server_address {
            xalign: 0;
            selectable: true;
            wrap: true;
            wrap-mode: word_char;
          }

          // A green dot or a warning sign, then the words: the colour is
          // not the only cue.
          Box {
            spacing: 6;

            Box server_dot {
              valign: center;
              visible: false;

              styles [
                "connection-dot",
                "success",
              ]
            }

            Image server_warning {
              icon-name: "dialog-warning-symbolic";
              pixel-size: 12;
              valign: start;
              margin-top: 2;
              visible: false;

              styles [
                "warning",
              ]
            }

            Label server_status {
              xalign: 0;
              hexpand: true;
              wrap: true;
              wrap-mode: word_char;

              styles [
                "subtitle",
              ]
            }
          }
        };
      }

      Adw.ActionRow user_row {
        title: _("User");
        subtitle-selectable: true;

        styles [
          "property",
        ]
      }

      // Runs app.logout (main.rs) and closes the dialog.
      Adw.ButtonRow logout_row {
        title: _("Log Out");
        action-name: "app.logout";

        styles [
          "destructive-action",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      // The toggles in the order of the "color-scheme" setting (0, 1, 2).
      Adw.ActionRow {
        title: _("Style");

        [suffix]
        Adw.ToggleGroup color_scheme {
          valign: center;

          Adw.Toggle {
            label: _("Follow System");
          }

          Adw.Toggle {
            label: _("Light");
          }

          Adw.Toggle {
            label: _("Dark");
          }
        }
      }

      Adw.SwitchRow cover_colors {
        title: _("Cover Colors");
        subtitle: _("Tint the album page and the player with the colour of the cover");
      }
    }

    Adw.PreferencesGroup {
      title: _("Playback");

      Adw.SwitchRow endless_radio {
        title: _("Endless Radio");
        subtitle: _("When the queue ends, keep playing songs similar to the last one");
      }

      Adw.SwitchRow background_playback {
        title: _("Play After the Window Is Closed");
        subtitle: _("The music goes on; the controls stay in the system menu");
      }

      // The toggles in the order of the "replay-gain" setting (0, 1, 2).
      // They sit under the title, not beside it: three labels and a subtitle
      // do not fit one line (the labels would be cut short).
      Adw.PreferencesRow {
        title: _("Volume Normalization");
        activatable: false;

        child: Box {
          orientation: vertical;
          spacing: 9;
          margin-top: 9;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Box {
            orientation: vertical;
            spacing: 3;

            Label {
              label: _("Volume Normalization");
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;

              styles [
                "title",
              ]
            }

            Label {
              label: _("From ReplayGain tags; off keeps the signal unchanged");
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;

              styles [
                "subtitle",
              ]
            }
          }

          Adw.ToggleGroup replay_gain {
            homogeneous: true;

            Adw.Toggle {
              label: _("Off");
            }

            Adw.Toggle {
              label: _("Per Track");
            }

            Adw.Toggle {
              label: _("Per Album");
            }
          }
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");

      // Runs app.sync (main.rs): albums, then songs, as after connecting.
      Adw.ButtonRow sync_row {
        title: _("Sync Now");
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.sync";
      }

      Adw.ActionRow covers_row {
        title: _("Cover Cache");

        [suffix]
        Button clear_covers {
          label: _("Clear");
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Privacy");

      Adw.SwitchRow report_listens {
        title: _("Share Listening Activity");
        subtitle: _("The server sees what is playing and counts plays; it may pass them on to Last.fm or ListenBrainz");
      }
    }
  }
}
