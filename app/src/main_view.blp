using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

template $MusePlayerMainView: Adw.NavigationPage {
  // Lets the layout react to the window width (see the breakpoint at the end).
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    child: Adw.OverlaySplitView split {
      // Navigation on the left; its items and sections come from the pages of "views".
      sidebar: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          // Closes the sidebar when it slides in over the content (narrow windows).
          [start]
          ToggleButton {
            icon-name: "sidebar-show-symbolic";
            tooltip-text: _("Hide sidebar");
            visible: bind split.collapsed;
            active: bind split.show-sidebar bidirectional;
          }

          title-widget: Adw.WindowTitle {
            title: "muse-player";
          };

          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            primary: true;
            tooltip-text: _("Main Menu");
            menu-model: main_menu;
          }
        }

        content: Box {
          orientation: vertical;

          SearchEntry search_entry {
            placeholder-text: _("Search Library");
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 12;
            margin-end: 12;
          }

          Adw.ViewSwitcherSidebar {
            stack: views;
            vexpand: true;
          }

          // The now-playing card, placed here from code.
          Adw.Bin player_slot {}
        };
      };

      content: Box {
        orientation: vertical;

        Adw.ViewStack views {
          vexpand: true;

          // First item, so it opens by default.
          Adw.ViewStackPage {
            name: "start";
            title: _("Start");
            icon-name: "go-home-symbolic";

            // Its own navigation: an album opened from here comes back here.
            child: Adw.NavigationView {
              Adw.NavigationPage {
                title: _("Start");

                child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: _("Start");
                };

                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              content: $MusePlayerStartPage start_page {};
            };
              }
            };
          }

          // Section "Library" ---------------------------------------------

          Adw.ViewStackPage albums_page {
            name: "library";
            title: _("Albums");
            icon-name: "media-optical-symbolic";
            starts-section: true;
            section-title: _("Library");

            // Albums and artists open here, next to the sidebar.
            child: Adw.NavigationView library_nav {
              Adw.NavigationPage {
                title: _("Albums");

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    [start]
                    ToggleButton {
                      icon-name: "sidebar-show-symbolic";
                      tooltip-text: _("Show sidebar");
                      visible: bind split.collapsed;
                      active: bind split.show-sidebar bidirectional;
                    }

                    [end]
                    MenuButton {
                      icon-name: "view-sort-descending-symbolic";
                      tooltip-text: _("Sort");
                      menu-model: sort_menu;
                    }
                  }

                  // Hidden until the server cannot be reached.
                  [top]
                  Adw.Banner banner {
                    button-label: _("Retry");
                  }

                  content: Stack stack {
                    StackPage {
                      name: "status";

                      child: Adw.StatusPage status {
                        icon-name: "media-optical-symbolic";
                        title: _("Albums");
                      };
                    }

                    StackPage {
                      name: "library";

                      child: ScrolledWindow {
                        hscrollbar-policy: never;

                        // Only visible cards exist; they are reused while scrolling.
                        child: GridView grid {
                          min-columns: 2;
                          max-columns: 12;
                          single-click-activate: true;

                          styles [
                            "library-grid",
                          ]
                        };
                      };
                    }
                  };
                };
              }
            };
          }

          Adw.ViewStackPage {
            name: "artists";
            title: _("Artists");
            icon-name: "system-users-symbolic";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              content: Adw.StatusPage {
                icon-name: "system-users-symbolic";
                title: _("Artists");
                description: _("Coming soon");
              };
            };
          }

          // Section "Collections" -----------------------------------------

          Adw.ViewStackPage {
            name: "favorites";
            title: _("Favorites");
            icon-name: "starred-symbolic";
            starts-section: true;
            section-title: _("Collections");

            // Its own navigation: an album opened from here comes back here.
            child: Adw.NavigationView {
              Adw.NavigationPage {
                title: _("Favorites");

                child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              // Starred albums and songs, from the local database (main_view.rs).
              content: $MusePlayerResultsView favorites {};
            };
              }
            };
          }

          Adw.ViewStackPage {
            name: "playlists";
            title: _("Playlists");
            icon-name: "view-list-symbolic";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              content: Adw.StatusPage {
                icon-name: "view-list-symbolic";
                title: _("Playlists");
                description: _("Coming soon");
              };
            };
          }

          // Section "Discover" (AudioMuse-AI) -----------------------------

          Adw.ViewStackPage {
            name: "discover";
            title: _("Similar and Radio");
            icon-name: "applications-multimedia-symbolic";
            starts-section: true;
            section-title: _("Discover");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Show sidebar");
                  visible: bind split.collapsed;
                  active: bind split.show-sidebar bidirectional;
                }
              }

              content: Adw.StatusPage {
                icon-name: "applications-multimedia-symbolic";
                title: _("Similar and Radio");
                description: _("Coming soon");
              };
            };
          }
        }

        // Narrow windows: a compact now-playing bar, placed here from code.
        Revealer {
          reveal-child: bind split.collapsed;
          transition-type: slide_up;

          child: Adw.Bin mini_slot {};
        }
      };
    };

    // Narrow windows: the sidebar hides and slides in over the content.
    Adw.Breakpoint {
      condition ("max-width: 700sp")

      setters {
        split.collapsed: true;
      }
    }
  };
}

// Sort order of the album grid; a radio group driven by the "library.sort" action.
menu sort_menu {
  section {
    item {
      label: _("Name");
      action: "library.sort";
      target: "name";
    }

    item {
      label: _("Artist");
      action: "library.sort";
      target: "artist";
    }

    item {
      label: _("Year (Newest)");
      action: "library.sort";
      target: "year-desc";
    }

    item {
      label: _("Year (Oldest)");
      action: "library.sort";
      target: "year-asc";
    }

    item {
      label: _("Recently Added");
      action: "library.sort";
      target: "added";
    }
  }
}

// The main menu (the ☰ button above the sidebar).
menu main_menu {
  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }
  }
}
