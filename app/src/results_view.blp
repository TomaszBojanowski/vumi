using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// Albums as cards and songs as a list: search results, favourites.
// What stands above the songs, and scrolls away with them: put into the
// first row of the list from the code.
Box header {
  orientation: vertical;
  spacing: 24;
  margin-top: 24;
  margin-bottom: 12;

  // What the page puts above everything else (set_header_top), if anything.
  Adw.Bin header_top {
    visible: false;
  }

  Box albums_section {
    orientation: vertical;
    spacing: 12;

    Box {
      spacing: 8;

      Label {
        label: _("Albums");
        xalign: 0;

        styles [
          "title-4",
        ]
      }

      // How many, where the page wants it said (set_show_counts).
      Label albums_count {
        visible: false;

        styles [
          "section-count",
          "dim-label",
        ]
      }
    }

    // The cards as in the album grid: each in a cell of its own that
    // lights up under the pointer and takes the keyboard focus, packed
    // from the start of the line (a few albums do not spread over it).
    // A cover stands 9 px inside its cell (the cell's padding and the
    // card's margin): the box starts that much earlier (style.css), so the
    // covers line up with the heading.
    FlowBox albums_box {
      selection-mode: none;
      homogeneous: true;
      halign: start;
      max-children-per-line: 12;

      styles [
        "album-cells",
      ]
    }
  }

  // The heading of the songs, and at its end what the page puts there
  // (set_songs_end), if anything.
  Box songs_title {
    spacing: 8;

    Label {
      label: _("Songs");
      xalign: 0;

      styles [
        "title-4",
      ]
    }

    Label songs_count {
      visible: false;

      styles [
        "section-count",
        "dim-label",
      ]
    }

    Adw.Bin songs_end {
      halign: end;
      hexpand: true;
      valign: center;
      visible: false;
    }
  }
}

template $VumiResultsView: Adw.Bin {
  child: Stack stack {
    StackPage {
      name: "results";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        // Scrollable itself, so the list inside still knows what is on screen.
        child: Adw.ClampScrollable {
          maximum-size: 1000;

          // Only rows on screen exist; they are reused while scrolling. The
          // first row holds "header" below, the others one song each. The
          // rows are styled to look like a boxed list (style.css).
          child: ListView songs_list {
            single-click-activate: true;

            styles [
              "song-list",
            ]
          };
        };
      };
    }

    StackPage {
      name: "empty";

      // Texts set from code: they differ between search and favourites.
      child: Adw.StatusPage empty_page {
        icon-name: "system-search-symbolic";
      };
    }
  };
}
