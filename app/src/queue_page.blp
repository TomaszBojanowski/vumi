using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// The play queue, in a panel on the right.
template $VumiQueuePage: Adw.Bin {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      // Hides the queue while it lies over the content (shown from
      // main_view.rs, setup_queue): in the narrowest windows it covers the
      // whole window and a pointer has nothing else to close it with. The
      // mirror of the sidebar's own "Hide Sidebar" button.
      [start]
      Button hide_button {
        icon-name: "sidebar-show-right-symbolic";
        tooltip-text: _("Hide Queue");
        visible: false;
      }

      title-widget: Adw.WindowTitle {
        title: _("Queue");
      };
    }

    // How many tracks, how long, how much is left: set from the code. On a
    // line of its own, free to wrap: as the title's subtitle it would be cut
    // short, the panel is narrow and the header has little room.
    [top]
    Label summary {
      visible: false;
      wrap: true;
      justify: center;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 6;

      styles [
        "caption",
        "dim-label",
      ]
    }

    // What can be done with the queue as a whole.
    [top]
    Box actions {
      visible: false;
      halign: center;
      spacing: 6;
      margin-bottom: 6;

      Button shuffle_button {
        icon-name: "media-playlist-shuffle-symbolic";
        // Not "Shuffle" (play in a random order): this reorders the queue.
        tooltip-text: C_("queue", "Shuffle Queue");

        styles [
          "flat",
        ]
      }

      Button save_button {
        icon-name: "document-save-as-symbolic";
        tooltip-text: _("Save as Playlist");

        styles [
          "flat",
        ]
      }

      Button clear_button {
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Clear Queue");

        styles [
          "flat",
        ]
      }
    }

    content: Stack stack {
      StackPage {
        name: "queue";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          // Only rows on screen exist; they are reused while scrolling. The
          // rows are styled to look like a boxed list (style.css).
          child: ListView list {
            single-click-activate: true;

            styles [
              "song-list",
              "queue-list",
            ]
          };
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "view-list-symbolic";
          title: _("Nothing Queued");
          description: _("Play an album, a song or the radio");
        };
      }
    };
  };
}
