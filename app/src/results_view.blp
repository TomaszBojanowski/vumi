using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// Albums as cards and songs as a list: search results, favourites.
template $VumiResultsView: Adw.Bin {
  child: Stack stack {
    StackPage {
      name: "results";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 1000;

          child: Box {
            orientation: vertical;
            spacing: 24;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 24;
            margin-end: 24;

            Box albums_section {
              orientation: vertical;
              spacing: 12;

              Label {
                label: _("Albums");
                xalign: 0;

                styles [
                  "title-4",
                ]
              }

              FlowBox albums_box {
                selection-mode: none;
                homogeneous: true;
                max-children-per-line: 6;
                column-spacing: 12;
                row-spacing: 12;
              }
            }

            Box songs_section {
              orientation: vertical;
              spacing: 12;

              Label {
                label: _("Songs");
                xalign: 0;

                styles [
                  "title-4",
                ]
              }

              ListBox songs_list {
                selection-mode: none;

                styles [
                  "boxed-list",
                ]
              }
            }
          };
        };
      };
    }

    StackPage {
      name: "empty";

      // Texts set from code: they differ between search and favourites.
      child: Adw.StatusPage empty_page {
        icon-name: "system-search-symbolic";
      };
    }
  };
}
