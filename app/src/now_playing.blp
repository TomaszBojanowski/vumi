using Gtk 4.0;
using Adw 1;

translation-domain "muse-player";

// The now-playing card at the bottom of the sidebar.
template $MusePlayerNowPlaying: Adw.Bin {
  // Hidden until something plays, then slides up.
  child: Revealer revealer {
    transition-type: slide_up;

    child: Box pill {
      orientation: vertical;
      spacing: 10;
      margin-top: 6;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      styles [
        "now-playing-pill",
        "now-playing-card",
      ]

      Box {
        orientation: vertical;
        spacing: 10;
        margin-top: 12;
        margin-start: 12;
        margin-end: 12;

        // A square cover as wide as the sidebar. The sidebar is 300 wide and
        // the card has 12 + 12 of margins on each side, so the height is fixed
        // too: the card keeps its size before the cover arrives.
        AspectFrame cover_frame {
          ratio: 1;
          obey-child: false;
          height-request: 252;

          child: Overlay {
            overflow: hidden;

            styles [
              "pill-cover",
            ]

            child: Image {
              icon-name: "audio-x-generic-symbolic";
              pixel-size: 48;
              opacity: 0.6;
            };

            [overlay]
            Picture cover {
              content-fit: cover;
            }
          };
        }

        Box {
          orientation: vertical;

          Label title {
            xalign: 0;
            ellipsize: end;
            max-width-chars: 1;

            styles [
              "heading",
              "pill-title",
            ]
          }

          Label artist {
            xalign: 0;
            ellipsize: end;
            max-width-chars: 1;
            opacity: 0.75;

            styles [
              "caption",
            ]
          }

          Label album {
            xalign: 0;
            ellipsize: end;
            max-width-chars: 1;
            opacity: 0.6;

            styles [
              "caption",
            ]
          }

        }
      }

      // Dragging it seeks; the player moves it while music plays. Lined up
      // with the cover and the labels; the times sit right under it.
      Box {
        orientation: vertical;
        spacing: 2;
        margin-start: 12;
        margin-end: 12;

        Scale progress {
          styles [
            "pill-progress",
          ]

          adjustment: Adjustment {
            lower: 0;
            upper: 1;
          };
        }

        Box {
          Label elapsed {
            hexpand: true;
            xalign: 0;
            opacity: 0.75;

            styles [
              "caption",
              "numeric",
            ]
          }

          Label total {
            xalign: 1;
            opacity: 0.75;

            styles [
              "caption",
              "numeric",
            ]
          }
        }
      }

      // Playback controls in the middle, whatever sits at the sides.
      CenterBox {
        margin-start: 8;
        margin-end: 8;
        margin-bottom: 10;

        start-widget: Button queue_button {
          icon-name: "view-list-symbolic";
          tooltip-text: _("Queue");
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        };

        center-widget: Box {
          spacing: 8;

          Button previous {
            icon-name: "media-skip-backward-symbolic";
            tooltip-text: _("Previous");
            valign: center;

            styles [
              "flat",
              "circular",
            ]
          }

          Button play_pause {
            icon-name: "media-playback-pause-symbolic";
            valign: center;

            styles [
              "circular",
              "pill-play",
            ]
          }

          Button next {
            icon-name: "media-skip-forward-symbolic";
            tooltip-text: _("Next");
            valign: center;

            styles [
              "flat",
              "circular",
            ]
          }
        };

        // The current song's star, put in from the code.
        end-widget: Adw.Bin star_slot {
          valign: center;
        };
      }
    };
  };
}
