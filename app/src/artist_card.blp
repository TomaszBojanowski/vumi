using Gtk 4.0;

template $VumiArtistCard: Box {
  orientation: vertical;
  spacing: 6;
  margin-top: 12;
  margin-bottom: 12;
  margin-start: 12;
  margin-end: 12;

  // The picture, or the initials for artists without one (artist_avatar.rs).
  // The first card of a letter also shows the letter over it (made in code).
  Overlay overlay {
    child: $VumiArtistAvatar avatar {};
  }

  // The name and the number of albums. The box is always as tall as with a
  // two-line name (set in code), so every card, and with it every row, is as
  // tall.
  Box names {
    orientation: vertical;
    spacing: 6;
    valign: start;
    hexpand: true;

    Label name {
      justify: center;
      wrap: true;
      wrap-mode: word_char;
      lines: 2;
      ellipsize: end;
      max-width-chars: 16;

      styles [
        "heading",
      ]
    }

    Label albums {
      styles [
        "caption",
        "dim-label",
      ]
    }
  }
}
