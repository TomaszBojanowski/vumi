using Gtk 4.0;

template $VumiAlbumCard: Box {
  orientation: vertical;
  spacing: 6;
  margin-top: 6;
  margin-bottom: 6;
  margin-start: 6;
  margin-end: 6;

  // A square, 160 px or as wide as the album grid makes the card
  // (set_cover_grows): the cover is shown whole, never cropped. The note icon
  // stays underneath; the cover covers it once loaded.
  $VumiSquare cover_frame {
    child: Overlay {
      width-request: 160;
      height-request: 160;
      overflow: hidden;

      styles [
        "card",
      ]

      // Pictures that only decorate: the card's name says what it is.
      child: Image {
        icon-name: "audio-x-generic-symbolic";
        pixel-size: 64;
        accessible-role: presentation;

        styles [
          "dim-label",
        ]
      };

      [overlay]
      Picture cover {
        content-fit: contain;
        accessible-role: presentation;
      }
    };
  }

  // max-width-chars: 1 keeps long titles from widening the grid columns;
  // the label still fills the card and ellipsizes at its edge.
  Label title {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 1;

    styles [
      "heading",
    ]
  }

  Label artist {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 1;

    styles [
      "dim-label",
      "caption",
    ]
  }
}
