using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

// The Preferences dialog (Ctrl+,).
template $VumiPreferences: Adw.PreferencesDialog {
  // A dialog with a breakpoint (at the end) has to name its smallest size.
  width-request: 360;
  height-request: 294;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Account");

      // Who is logged in and where, and whether the server answers
      // (preferences.rs). Log Out asks first.
      Adw.PreferencesRow {
        title: _("Account");
        activatable: false;

        child: Box {
          spacing: 12;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;

            Box {
              spacing: 12;

              Adw.Avatar avatar {
                size: 44;
                show-initials: true;
                valign: center;
              }

              Box {
                orientation: vertical;
                spacing: 2;
                hexpand: true;
                valign: center;

                Label user_name {
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;

                  styles [
                    "heading",
                  ]
                }

                Label server_address {
                  xalign: 0;
                  selectable: true;
                  wrap: true;
                  wrap-mode: word_char;

                  styles [
                    "subtitle",
                  ]
                }

                // A green dot or a warning sign, then the words: the colour is
                // not the only cue.
                Box {
                  spacing: 6;

                  Box server_dot {
                    valign: center;
                    visible: false;

                    styles [
                      "connection-dot",
                      "success",
                    ]
                  }

                  Image server_warning {
                    icon-name: "dialog-warning-symbolic";
                    pixel-size: 12;
                    valign: start;
                    margin-top: 2;
                    visible: false;

                    styles [
                      "warning",
                    ]
                  }

                  Label server_status {
                    xalign: 0;
                    hexpand: true;
                    wrap: true;
                    wrap-mode: word_char;

                    styles [
                      "subtitle",
                    ]
                  }
                }
              }
            }

            // Narrow dialogs: Log Out goes under the text, in line with it
            // (the breakpoint at the end of this file).
            Button logout_below {
              label: _("Log Out");
              halign: start;
              margin-top: 10;
              margin-start: 56;
              visible: false;

              styles [
                "logout-button",
              ]
            }
          }

          Button logout_side {
            label: _("Log Out");
            valign: center;

            styles [
              "logout-button",
            ]
          }
        };
      }

      // What the local library holds and when it was last synced
      // (preferences.rs); the button does what Ctrl+R does.
      Adw.ActionRow library_row {
        title: _("Library");
        subtitle-lines: 0;

        [suffix]
        Button sync_button {
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Sync Now");
          valign: center;

          styles [
            "circular",
          ]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      // The toggles in the order of the "color-scheme" setting (0, 1, 2).
      Adw.ActionRow style_row {
        title: _("Style");

        [suffix]
        Adw.ToggleGroup color_scheme {
          valign: center;

          accessibility {
            labelled-by: style_row;
          }

          Adw.Toggle {
            label: _("Follow System");
          }

          Adw.Toggle {
            label: _("Light");
          }

          Adw.Toggle {
            label: _("Dark");
          }
        }
      }

      Adw.SwitchRow cover_colors {
        title: _("Cover Colors");
        subtitle: _("Tint the album page and the player with the color of the cover");
      }
    }

    Adw.PreferencesGroup {
      title: _("Playback");

      Adw.SwitchRow endless_radio {
        title: _("Endless Radio");
        subtitle: _("When the queue ends, keep playing songs similar to the last one");
      }

      Adw.SwitchRow background_playback {
        title: _("Play After the Window Is Closed");
        subtitle: _("The music goes on; the controls stay in the system menu");
      }

      // The toggles in the order of the "replay-gain" setting (0, 1, 2).
      // They sit under the title, not beside it: three labels and a subtitle
      // do not fit one line (the labels would be cut short).
      Adw.PreferencesRow {
        title: _("Volume Normalization");
        activatable: false;

        child: Box {
          orientation: vertical;
          spacing: 9;
          margin-top: 9;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Box {
            orientation: vertical;
            spacing: 3;

            Label replay_gain_title {
              label: _("Volume Normalization");
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;

              styles [
                "title",
              ]
            }

            Label {
              label: _("From ReplayGain tags; off keeps the signal unchanged");
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;

              styles [
                "subtitle",
              ]
            }
          }

          Adw.ToggleGroup replay_gain {
            homogeneous: true;

            accessibility {
              labelled-by: replay_gain_title;
            }

            Adw.Toggle {
              label: _("Off");
            }

            Adw.Toggle {
              label: _("Per Track");
            }

            Adw.Toggle {
              label: _("Per Album");
            }
          }
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Local Data");

      Adw.ActionRow covers_row {
        title: _("Cover Cache");

        [suffix]
        Button clear_covers {
          label: _("Clear");
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Privacy");

      Adw.SwitchRow report_listens {
        title: _("Share Listening Activity");
        subtitle: _("The server sees what is playing and counts plays; it may pass them on to Last.fm or ListenBrainz");
      }
    }
  }

  // Narrow: no room for Log Out beside the account, so it goes below.
  Adw.Breakpoint {
    condition ("max-width: 450sp")

    setters {
      logout_side.visible: false;
      logout_below.visible: true;
    }
  }
}
