using Gtk 4.0;
using Adw 1;

translation-domain "vumi";

template $VumiArtistPage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 1100;

        // No side margins here: the album grid uses the whole width, as the
        // Albums grid does (two cards fit a 360 px window); the parts above
        // and below keep 12 px each.
        child: Box {
          orientation: vertical;
          spacing: 24;
          margin-top: 24;
          margin-bottom: 24;

          Box {
            orientation: vertical;
            spacing: 12;
            halign: center;
            margin-start: 12;
            margin-end: 12;

            // Initials until the photo arrives, or for good if there is none.
            // Decoration: the name below is the page's title. (AdwAvatar
            // would also say "Avatar of …", untranslated.)
            Adw.Avatar avatar {
              size: 160;
              show-initials: true;
              accessible-role: presentation;
            }

            Label name {
              wrap: true;
              justify: center;

              styles [
                "title-1",
              ]
            }

            Label details {
              styles [
                "dim-label",
              ]
            }
          }

          // "About": hidden until the server has a biography.
          Box about {
            margin-start: 12;
            margin-end: 12;
            orientation: vertical;
            spacing: 6;
            visible: false;

            Label {
              label: _("About");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            Label about_text {
              xalign: 0;
              wrap: true;
              lines: 4;
              ellipsize: end;
            }

            Button about_more {
              label: _("Show More");
              halign: start;
              visible: false;

              styles [
                "flat",
              ]
            }
          }

          Label albums_title {
            label: _("Albums");
            xalign: 0;
            margin-start: 12;
            margin-end: 12;

            styles [
              "heading",
            ]
          }

          // Few albums per artist, so a simple FlowBox is enough here.
          FlowBox albums {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 2;
            max-children-per-line: 8;
            activate-on-single-click: true;
          }

          // Why the artist could not be shown (show_error).
          Adw.StatusPage error_status {
            icon-name: "network-offline-symbolic";
            visible: false;
            margin-start: 12;
            margin-end: 12;

            styles [
              "compact",
            ]
          }
        };
      };
    };
  };
}
