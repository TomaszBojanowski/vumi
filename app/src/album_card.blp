using Gtk 4.0;

template $MusePlayerAlbumCard: Box {
  orientation: vertical;
  spacing: 6;
  margin-top: 6;
  margin-bottom: 6;
  margin-start: 6;
  margin-end: 6;

  // The note icon stays underneath; the cover covers it once loaded.
  Overlay {
    width-request: 160;
    height-request: 160;
    overflow: hidden;

    styles [
      "card",
    ]

    child: Image {
      icon-name: "audio-x-generic-symbolic";
      pixel-size: 64;

      styles [
        "dim-label",
      ]
    };

    [overlay]
    Picture cover {
      content-fit: cover;
    }
  }

  // max-width-chars: 1 keeps long titles from widening the grid columns;
  // the label still fills the card and ellipsizes at its edge.
  Label title {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 1;

    styles [
      "heading",
    ]
  }

  Label artist {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 1;

    styles [
      "dim-label",
      "caption",
    ]
  }
}
